<h1>You have a Craftsmas match, <%= @gifter[:name] %></h1>
<p>
  You have been matched with <strong><%= @match_name %>!
  <br />
</p>
<h2>Q&A with <%= @match_name %></h2>
<ul style="list-style-type: none; padding: 5px; margin-bottom: 10px;">
  <% @questions.each do |q| %>
    <li><strong><%= q[:question] %></strong></li>
    <li><i><%= q[:answer] %><i></li>
  <% end %>
</ul>

<% if @other %>
  <h2>And a little more about <%= @match_name %></h2>
  <p>
    <%= @other %>
  </p>
<% end %>

<p>
<i>If you have any questions about your match, contact Dave or Alissa and we can help you out!</i>
</p>
